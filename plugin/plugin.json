              "exclusiveMinimum": 0
            },
            "flip": {
              "type": "boolean",
              "title": "Swap sides"
            },
            "align": {
              "type": "boolean",
              "title": "Align the boards first"
            }
          }
        }
      },
      {
        "name": "miter",
        "effect": "edit",
        "slots": [
          {
