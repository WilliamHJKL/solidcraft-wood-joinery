{
  "id": "wood-joinery",
  "name": "Wood joinery",
  "version": "0.14.0",
  "description": "Woodworking joints between boards: mortise and tenon, grooves, half laps, dowels, box joints, loose tenons, housings, miters, tongue and groove, scarfs, dovetails, screws and biscuits.",
  "capabilities": [
    "commands@0.2",
    "storage@0.1",
    "forms@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "data_format": 1,
    "entries": [
      {
        "name": "mortise-tenon",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "x-solidcraft-field-order": "declared",
          "x-solidcraft-icon": "icons/mortise-tenon.svg",
          "properties": {
            "rail": {
              "type": "array",
              "title": "Rail (empty = selection)",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "body"
                ]
              }
            },
            "stile": {
              "type": "array",
              "title": "Stile (empty = selection)",
              "maxItems": 1,
              "x-solidcraft-selection": {
                "version": 1,
                "accept": [
                  "body"
                ]
              }
            },
            "variant": {
              "type": "string",
              "title": "Joint",
              "default": "classic",
              "enum": [
                "classic",
                "haunched",
                "through",
                "bridle"
              ],
              "description": "classic and haunched are blind. through goes right through. bridle is an open slot."
            },
            "thickness": {
              "type": "number",
              "title": "Tenon thickness (empty = 1/3 of the rail)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "length": {
              "type": "number",
              "title": "Tenon length (empty = 3/4 of the stile)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "shoulder": {
              "type": "number",
              "title": "Shoulder (empty = the cheek width)",
              "unit": "mm",
              "minimum": 0
            },
            "haunch_width": {
              "type": "number",
              "title": "Haunch width (empty = tenon thickness)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "field": "variant",
                "eq": "haunched"
              }
            },
            "haunch_depth": {
              "type": "number",
              "title": "Haunch depth (empty = tenon thickness)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "field": "variant",
                "eq": "haunched"
              }
            },
            "glue_relief": {
              "type": "number",
              "title": "Glue relief",
              "unit": "mm",
              "minimum": 0,
              "default": 2
            },
            "clearance": {
              "type": "number",
              "title": "Clearance",
              "unit": "mm",
              "minimum": 0,
              "default": 0
            },
            "offset": {
              "type": "number",
              "title": "Offset from the centre",
              "unit": "mm",
              "default": 0
            },
            "double": {
              "type": "boolean",
              "title": "Double tenon"
            },
            "position": {
              "type": "string",
              "title": "Tenon position",
              "enum": [
                "centre",
                "low",
                "high"
              ],
              "default": "centre",
              "description": "low and high put the tenon level with a face of the rail."
            },
            "pegs": {
              "type": "integer",
              "title": "Pegs (0 to 2)",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            },
            "peg_diameter": {
              "type": "number",
              "title": "Peg diameter (empty = 6 or 8)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "field": "pegs",
                "in": [
                  1,
                  2
                ]
              }
            },
            "drawbore": {
              "type": "number",
              "title": "Drawbore (0 = plain; 1 to 2)",
              "unit": "mm",
              "minimum": 0,
              "default": 0,
              "x-solidcraft-visible-when": {
                "field": "pegs",
                "in": [
                  1,
                  2
                ]
              }
            },
            "wedges": {
              "type": "integer",
              "title": "Wedges (0 to 2)",
              "minimum": 0,
              "maximum": 2,
              "default": 0,
              "x-solidcraft-visible-when": {
                "field": "variant",
                "eq": "through"
              }
            },
            "wedge_thickness": {
              "type": "number",
              "title": "Wedge thickness (empty = 4)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "field": "variant",
                "eq": "through"
              }
            },
            "align": {
              "type": "boolean",
              "title": "Align the boards first"
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Mortise and tenon"
          },
          {
            "kind": "ribbon",
            "name": "Tenon"
          }
        ]
      },
      {
        "name": "loose-tenon",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "Loose tenon"
          },
          {
            "kind": "ribbon",
            "name": "Loose tenon"
          }
        ],
        "input_schema": {
          "type": "object",
          "x-solidcraft-field-order": "declared",
          "x-solidcraft-icon": "icons/loose-tenon.svg",
          "properties": {
            "first": {
              "type": "string",
              "title": "First board (empty = selection)"
            },
            "second": {
              "type": "string",
              "title": "Second board (empty = selection)"
            },
            "domino": {
              "type": "string",
              "title": "Festool Domino",
              "default": "custom",
              "enum": [
                "custom",
                "4x20",
                "5x30",
                "6x40",
                "8x40",
                "8x50",
                "10x50",
                "8x80",
                "8x100",
                "10x80",
                "10x100",
                "12x100",
                "14x100",
                "14x140"
              ],
              "description": "A Domino gives the tenon's thickness, width and length, and rounded ends. custom: the sizes below."
            },
            "domino_fit": {
              "type": "string",
              "title": "Second mortise width",
              "default": "medium",
              "enum": [
                "tight",
                "medium",
                "wide"
              ],
              "description": "The first mortise is tight. medium: 6 mm wider on the DF 500, 3 mm on the DF 700. wide: 10 mm, or 3 mm.",
              "x-solidcraft-visible-when": {
                "field": "domino",
                "in": [
                  "4x20",
                  "5x30",
                  "6x40",
                  "8x40",
                  "8x50",
                  "10x50",
                  "8x80",
                  "8x100",
                  "10x80",
                  "10x100",
                  "12x100",
                  "14x100",
                  "14x140"
                ]
              }
            },
            "thickness": {
              "type": "number",
              "title": "Tenon thickness (empty = 5 to 10, by thickness)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "domino",
                  "in": [
                    "4x20",
                    "5x30",
                    "6x40",
                    "8x40",
                    "8x50",
                    "10x50",
                    "8x80",
                    "8x100",
                    "10x80",
                    "10x100",
                    "12x100",
                    "14x100",
                    "14x140"
                  ]
                }
              }
            },
            "width": {
              "type": "number",
              "title": "Tenon width (empty = by the joint)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "domino",
                  "in": [
                    "4x20",
                    "5x30",
                    "6x40",
                    "8x40",
                    "8x50",
                    "10x50",
                    "8x80",
                    "8x100",
                    "10x80",
                    "10x100",
                    "12x100",
                    "14x100",
                    "14x140"
                  ]
                }
              }
            },
            "length": {
              "type": "number",
              "title": "Tenon length (empty = 5 thicknesses)",
              "unit": "mm",
              "exclusiveMinimum": 0,
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "domino",
                  "in": [
                    "4x20",
                    "5x30",
                    "6x40",
                    "8x40",
                    "8x50",
                    "10x50",
                    "8x80",
                    "8x100",
                    "10x80",
                    "10x100",
                    "12x100",
                    "14x100",
                    "14x140"
                  ]
                }
              }
            },
            "count": {
              "type": "integer",
              "title": "Number of tenons (empty = by length)",
              "minimum": 1,
              "maximum": 40
            },
            "glue_relief": {
              "type": "number",
              "title": "Glue relief",
              "unit": "mm",
              "minimum": 0,
              "default": 1
            },
            "tenon_bodies": {
              "type": "boolean",
              "title": "Add the tenons as bodies",
              "default": true
            },
            "align": {
              "type": "boolean",
              "title": "Align the boards first"
            }
          }
        }
      },
      {
