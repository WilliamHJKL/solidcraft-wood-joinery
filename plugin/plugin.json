              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "title": "Tongue length (empty = 1/2 of the board)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "glue_relief": {
              "type": "number",
              "title": "Glue relief",
              "unit": "mm",
              "minimum": 0,
              "default": 1
            },
            "align": {
              "type": "boolean",
              "title": "Align the boards first"
            }
          }
        }
      },
      {
        "name": "housing",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
