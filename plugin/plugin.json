            "width": {
              "type": "number",
              "title": "Width (empty = 6)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "title": "Depth (empty = 8)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "offset": {
              "type": "number",
              "title": "Offset from the edge (empty = centred)",
              "unit": "mm",
              "minimum": 0
            },
            "stop_start": {
              "type": "number",
              "title": "Stop at start",
              "unit": "mm",
              "minimum": 0,
              "default": 0
            },
            "stop_end": {
              "type": "number",
              "title": "Stop at end",
              "unit": "mm",
              "minimum": 0,
              "default": 0
