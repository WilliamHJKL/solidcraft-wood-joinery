{
  "id": "wood-joinery",
  "name": "Wood joinery",
  "version": "0.9.5",
  "description": "Woodworking joints between boards: mortise and tenon, grooves, half laps, dowels, box joints, loose tenons, housings, miters, tongue and groove, scarfs, dovetails, screws and biscuits.",
  "capabilities": [
    "commands@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "mortise-tenon",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/mortise-tenon.svg",
          "properties": {
            "rail": {
              "type": "string",
              "title": "Rail (empty = selection)"
            },
            "stile": {
              "type": "string",
              "title": "Stile (empty = selection)"
            },
            "variant": {
              "type": "string",
              "title": "Joint",
              "default": "classic",
              "enum": [
                "classic",
                "haunched",
                "through",
                "bridle"
              ],
              "description": "classic and haunched are blind. through goes right through. bridle is an open slot."
            },
            "thickness": {
              "type": "number",
              "title": "Tenon thickness (empty = 1/3 of the rail)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "length": {
              "type": "number",
              "title": "Tenon length (empty = 2/3 of the stile)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "shoulder": {
              "type": "number",
              "title": "Shoulder (empty = the cheek width)",
              "unit": "mm",
              "minimum": 0
            },
            "haunch_width": {
              "type": "number",
              "title": "Haunch width (empty = 1/5 of the rail)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "haunch_depth": {
              "type": "number",
              "title": "Haunch depth (empty = tenon thickness)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "glue_relief": {
              "type": "number",
              "title": "Glue relief",
              "unit": "mm",
              "minimum": 0,
              "default": 2
            },
            "clearance": {
              "type": "number",
              "title": "Clearance",
              "unit": "mm",
              "minimum": 0,
              "default": 0
            },
            "offset": {
              "type": "number",
              "title": "Offset from the centre",
              "unit": "mm",
              "default": 0
            },
            "align": {
              "type": "boolean",
              "title": "Align the boards first"
            },
            "double": {
              "type": "boolean",
              "title": "Double tenon"
            },
            "position": {
              "type": "string",
              "title": "Tenon position",
              "enum": [
                "centre",
                "low",
                "high"
              ],
              "default": "centre",
              "description": "low and high put the tenon level with a face of the rail."
            },
            "pegs": {
              "type": "integer",
              "title": "Pegs through the tenon (0 to 2)",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            },
            "peg_diameter": {
              "type": "number",
              "title": "Peg diameter (empty = 6 or 8)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "wedges": {
              "type": "integer",
              "title": "Wedges in a through tenon (0 to 2)",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            }
          }
        },
        "slots": [
          {
            "kind": "menu",
            "name": "Mortise and tenon"
          },
          {
            "kind": "ribbon",
            "name": "Tenon"
          }
        ]
      },
      {
        "name": "loose-tenon",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "Loose tenon"
          },
          {
            "kind": "ribbon",
            "name": "Loose tenon"
          }
        ],
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/loose-tenon.svg",
          "properties": {
            "first": {
              "type": "string",
              "title": "First board (empty = selection)"
            },
            "second": {
              "type": "string",
              "title": "Second board (empty = selection)"
            },
            "thickness": {
              "type": "number",
              "title": "Tenon thickness (empty = 5 to 10, by thickness)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "title": "Tenon width (empty = by the joint)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "length": {
              "type": "number",
              "title": "Tenon length (empty = 5 thicknesses)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "count": {
              "type": "integer",
              "title": "Number of tenons (empty = by length)",
              "minimum": 1,
              "maximum": 40
            },
            "glue_relief": {
              "type": "number",
              "title": "Glue relief",
              "unit": "mm",
              "minimum": 0,
              "default": 1
            },
            "tenon_bodies": {
              "type": "boolean",
              "title": "Add the tenons as bodies",
              "default": true
            },
            "align": {
              "type": "boolean",
              "title": "Align the boards first"
            }
          }
        }
      },
      {
        "name": "groove",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "Groove"
          },
          {
            "kind": "ribbon",
            "name": "Groove"
          }
        ],
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/groove.svg",
          "properties": {
            "body": {
              "type": "string",
              "title": "Board (empty = selection)"
            },
            "face": {
              "type": "string",
              "title": "Face (empty = selection)",
              "enum": [
                "+x",
                "-x",
                "+y",
                "-y",
                "+z",
                "-z"
              ]
            },
            "width": {
              "type": "number",
              "title": "Width (empty = 6)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "title": "Depth (empty = 8)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "offset": {
              "type": "number",
              "title": "Offset from the edge (empty = centred)",
              "unit": "mm",
              "minimum": 0
            },
            "stop_start": {
              "type": "number",
              "title": "Stop at start",
              "unit": "mm",
              "minimum": 0,
              "default": 0
            },
            "stop_end": {
              "type": "number",
              "title": "Stop at end",
              "unit": "mm",
              "minimum": 0,
              "default": 0
            },
            "along": {
              "type": "string",
              "title": "Direction (empty = the long side)",
              "enum": [
                "x",
                "y",
                "z"
              ]
            }
          }
        }
      },
