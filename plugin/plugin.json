            "depth": {
              "type": "number",
              "title": "Depth (empty = 1/3 of the side)",
              "unit": "mm",
              "exclusiveMinimum": 0
            },
            "stop_start": {
              "type": "number",
              "title": "Stop at start",
              "unit": "mm",
              "minimum": 0,
              "default": 0
